    [id(1063)] HRESULT DrawTriangleLines([in] IRayLibVector2* v1, [in] IRayLibVector2* v2, [in] IRayLibVector2* v3, [in] IRayLibColor* color);

    [id(1070)] HRESULT DrawPoly([in] IRayLibVector2* center, [in] long sides, [in] float radius, [in] float rotation, [in] IRayLibColor* color);
    [id(1071)] HRESULT DrawPolyLines([in] IRayLibVector2* center, [in] long sides, [in] float radius, [in] float rotation, [in] IRayLibColor* color);
    [id(1072)] HRESULT DrawPolyLinesEx([in] IRayLibVector2* center, [in] long sides, [in] float radius, [in] float rotation, [in] float lineThick, [in] IRayLibColor* color);

    // Spline segment point evaluation functions, for a given t [0.0f .. 1.0f]
    [id(1080)] HRESULT GetSplinePointLinear([in] IRayLibVector2* startPos, [in] IRayLibVector2* endPos, [in] float t, [out, retval] IRayLibVector2** pRetVal);
    [id(1081)] HRESULT GetSplinePointBasis([in] IRayLibVector2* p1, [in] IRayLibVector2* p2, [in] IRayLibVector2* p3, [in] IRayLibVector2* p4, [in] float t, [out, retval] IRayLibVector2** pRetVal);
    [id(1082)] HRESULT GetSplinePointCatmullRom([in] IRayLibVector2* p1, [in] IRayLibVector2* p2, [in] IRayLibVector2* p3, [in] IRayLibVector2* p4, [in] float t, [out, retval] IRayLibVector2** pRetVal);
    [id(1083)] HRESULT GetSplinePointBezierQuadratic([in] IRayLibVector2* p1, [in] IRayLibVector2* c2, [in] IRayLibVector2* p3, [in] float t, [out, retval] IRayLibVector2** pRetVal);
    [id(1084)] HRESULT GetSplinePointBezierCubic([in] IRayLibVector2* p1, [in] IRayLibVector2* c2, [in] IRayLibVector2* c3, [in] IRayLibVector2* p4, [in] float t, [out, retval] IRayLibVector2** pRetVal);

    // Basic shapes collision detection functions
    [id(1090)] HRESULT CheckCollisionRecs([in] IRayLibRectangle* rec1, [in] IRayLibRectangle* rec2, [out, retval] VARIANT_BOOL* pRetVal);
    [id(1091)] HRESULT CheckCollisionCircles([in] IRayLibVector2* center1, [in] float radius1, [in] IRayLibVector2* center2, [in] float radius2, [out, retval] VARIANT_BOOL* pRetVal);
    [id(1092)] HRESULT CheckCollisionCircleRec([in] IRayLibVector2* center, [in] float radius, [in] IRayLibRectangle* rec, [out, retval] VARIANT_BOOL* pRetVal);
    [id(1093)] HRESULT CheckCollisionCircleLine([in] IRayLibVector2* center, [in] float radius, [in] IRayLibVector2* p1, [in] IRayLibVector2* p2, [out, retval] VARIANT_BOOL* pRetVal);
    [id(1094)] HRESULT CheckCollisionPointRec([in] IRayLibVector2* point, [in] IRayLibRectangle* rec, [out, retval] VARIANT_BOOL* pRetVal);
    [id(1095)] HRESULT CheckCollisionPointCircle([in] IRayLibVector2* point, [in] IRayLibVector2* center, [in] float radius, [out, retval] VARIANT_BOOL* pRetVal);
    [id(1096)] HRESULT CheckCollisionPointTriangle([in] IRayLibVector2* point, [in] IRayLibVector2* p1, [in] IRayLibVector2* p2, [in] IRayLibVector2* p3, [out, retval] VARIANT_BOOL* pRetVal);
    [id(1097)] HRESULT CheckCollisionPointLine([in] IRayLibVector2* point, [in] IRayLibVector2* p1, [in] IRayLibVector2* p2, [in] long threshold, [out, retval] VARIANT_BOOL* pRetVal);

    [id(1100)] HRESULT GetCollisionRec([in] IRayLibRectangle* rec1, [in] IRayLibRectangle* rec2, [out, retval] IRayLibRectangle** pRetVal);


    // Color/pixel related functions
    [id(1200)] HRESULT ColorIsEqual([in] IRayLibColor* col1, [in] IRayLibColor* col2, [out, retval] VARIANT_BOOL* pRetVal);
    [id(1201)] HRESULT Fade([in] IRayLibColor* color, [in] float alpha, [out, retval] IRayLibColor** pRetVal);


    //////////////////////////////////////////////
    // Module: RTEXT

    // Font loading/unloading functions

    // Text drawing functions
    [id(2020)] HRESULT DrawFPS([in] long posX, [in] long posY);
    [id(2021)] HRESULT DrawText([in] BSTR text, [in] long posX, [in] long posY, [in] long fontSize, [in] IRayLibColor* color);

    // Text font info functions
    [id(2040)] HRESULT SetTextLineSpacing([in] long spacing);
    [id(2041)] HRESULT MeasureText([in] BSTR text, [in] long fontSize, [out, retval] long* pRetVal);

    // Text strings management functions (no UTF-8 strings, only byte chars)
    [id(2073)] HRESULT TextIsEqual([in] BSTR text1, [in] BSTR text2, [out, retval] VARIANT_BOOL* pRetVal);
    [id(2074)] HRESULT TextLength([in] BSTR text, [out, retval] long* pRetVal);
    [id(2075), vararg] HRESULT TextFormat([in] BSTR text, [in] SAFEARRAY(VARIANT) args, [out, retval] BSTR* pRetVal);
    [id(2076)] HRESULT TextSubtext([in] BSTR text, [in] long position, [in] long length, [out, retval] BSTR* pRetVal);
    [id(2077)] HRESULT TextRemoveSpaces([in] BSTR text, [out, retval] BSTR* pRetVal);
    [id(2078)] HRESULT GetTextBetween([in] BSTR text, [in] BSTR begin, [in] BSTR end, [out, retval] BSTR* pRetVal);
    [id(2079)] HRESULT TextReplace([in] BSTR text, [in] BSTR search, [in] BSTR replacement, [out, retval] BSTR* pRetVal);
    [id(2080)] HRESULT TextReplaceAlloc([in] BSTR text, [in] BSTR search, [in] BSTR replacement, [out, retval] BSTR* pRetVal);
    [id(2081)] HRESULT TextReplaceBetween([in] BSTR text, [in] BSTR begin, [in] BSTR end, [in] BSTR replacement, [out, retval] BSTR* pRetVal);
    [id(2082)] HRESULT TextReplaceBetweenAlloc([in] BSTR text, [in] BSTR begin, [in] BSTR end, [in] BSTR replacement, [out, retval] BSTR* pRetVal);

    [id(2090)] HRESULT TextFindIndex([in] BSTR text, [in] BSTR search, [out, retval] long* pRetVal);
    [id(2091)] HRESULT TextToUpper([in] BSTR text, [out, retval] BSTR* pRetVal);
    [id(2092)] HRESULT TextToLower([in] BSTR text, [out, retval] BSTR* pRetVal);
    [id(2093)] HRESULT TextToPascal([in] BSTR text, [out, retval] BSTR* pRetVal);
    [id(2094)] HRESULT TextToSnake([in] BSTR text, [out, retval] BSTR* pRetVal);
    [id(2095)] HRESULT TextToCamel([in] BSTR text, [out, retval] BSTR* pRetVal);
    [id(2096)] HRESULT TextToInteger([in] BSTR text, [out, retval] long* pRetVal);
    [id(2097)] HRESULT TextToFloat([in] BSTR text, [out, retval] float* pRetVal);


    //////////////////////////////////////////////
    // Module: RMODELS

    // Basic geometric 3D shapes drawing functions
    [id(3000)] HRESULT DrawLine3D([in] IRayLibVector3* startPos, [in] IRayLibVector3* endPos, [in] IRayLibColor* color);
    [id(3001)] HRESULT DrawPoint3D([in] IRayLibVector3* position, [in] IRayLibColor* color);
    [id(3002)] HRESULT DrawCircle3D([in] IRayLibVector3* center, [in] float radius, [in] IRayLibVector3* rotationAxis, [in] float rotationAngle, [in] IRayLibColor* color);
    [id(3003)] HRESULT DrawTriangle3D([in] IRayLibVector3* v1, [in] IRayLibVector3* v2, [in] IRayLibVector3* v3, [in] IRayLibColor* color);

    [id(3005)] HRESULT DrawCube([in] IRayLibVector3* position, [in] float width, [in] float height, [in] float length, [in] IRayLibColor* color);
    [id(3006)] HRESULT DrawCubeV([in] IRayLibVector3* position, [in] IRayLibVector3* size, [in] IRayLibColor* color);
    [id(3007)] HRESULT DrawCubeWires([in] IRayLibVector3* position, [in] float width, [in] float height, [in] float length, [in] IRayLibColor* color);
    [id(3008)] HRESULT DrawCubeWiresV([in] IRayLibVector3* position, [in] IRayLibVector3* size, [in] IRayLibColor* color);
    [id(3009)] HRESULT DrawSphere([in] IRayLibVector3* centerPos, [in] float radius, [in] IRayLibColor* color);
    [id(3010)] HRESULT DrawSphereEx([in] IRayLibVector3* centerPos, [in] float radius, [in] long rings, [in] long slices, [in] IRayLibColor* color);
    [id(3011)] HRESULT DrawSphereWires([in] IRayLibVector3* centerPos, [in] float radius, [in] long rings, [in] long slices, [in] IRayLibColor* color);
    [id(3012)] HRESULT DrawCylinder([in] IRayLibVector3* position, [in] float radiusTop, [in] float radiusBottom, [in] float height, [in] long slices, [in] IRayLibColor* color);
    [id(3013)] HRESULT DrawCylinderEx([in] IRayLibVector3* startPos, [in] IRayLibVector3* endPos, [in] float startRadius, [in] float endRadius, [in] long sides, [in] IRayLibColor* color);
    [id(3014)] HRESULT DrawCylinderWires([in] IRayLibVector3* position, [in] float radiusTop, [in] float radiusBottom, [in] float height, [in] long slices, [in] IRayLibColor* color);
    [id(3015)] HRESULT DrawCylinderWiresEx([in] IRayLibVector3* startPos, [in] IRayLibVector3* endPos, [in] float startRadius, [in] float endRadius, [in] long sides, [in] IRayLibColor* color);
    [id(3016)] HRESULT DrawCapsule([in] IRayLibVector3* startPos, [in] IRayLibVector3* endPos, [in] float radius, [in] long slices, [in] long rings, [in] IRayLibColor* color);
    [id(3017)] HRESULT DrawCapsuleWires([in] IRayLibVector3* startPos, [in] IRayLibVector3* endPos, [in] float radius, [in] long slices, [in] long rings, [in] IRayLibColor* color);
    [id(3018)] HRESULT DrawPlane([in] IRayLibVector3* centerPos, [in] IRayLibVector2* size, [in] IRayLibColor* color);
    [id(3019)] HRESULT DrawRay([in] IRayLibRay* ray, [in] IRayLibColor* color);
    [id(3020)] HRESULT DrawGrid([in] long slices, [in] float spacing);


    //////////////////////////////////////////////
    // Module: RAUDIO

    // Audio device management functions
    [id(4000)] HRESULT InitAudioDevice(void);
    [id(4001)] HRESULT CloseAudioDevice(void);
    [id(4002)] HRESULT IsAudioDeviceReady([out, retval] VARIANT_BOOL* pRetVal);
    [id(4003)] HRESULT SetMasterVolume([in] float volume);
    [id(4004)] HRESULT GetMasterVolume([out, retval] float* pRetVal);


    //////////////////////////////////////////////
    // CoRayLib helpers
    [id(20000)] HRESULT CreateColor([in] long r, [in] long g, [in] long b, [in] long a, [out, retval] IRayLibColor** pRetVal);
    [id(20001)] HRESULT CreateVector2([in] float x, [in] float y, [out, retval] IRayLibVector2** pRetVal);
    [id(20002)] HRESULT CreateVector3([in] float x, [in] float y, [in] float z, [out, retval] IRayLibVector3** pRetVal);
    [id(20003)] HRESULT CreateVector4([in] float x, [in] float y, [in] float z, [in] float w, [out, retval] IRayLibVector4** pRetVal);
    [id(20004)] HRESULT CreateQuaternion([in] float x, [in] float y, [in] float z, [in] float w, [out, retval] IRayLibVector4** pRetVal);
    [id(20005)] HRESULT CreateRectangle([in] float x, [in] float y, [in] float width, [in] float height, [out, retval] IRayLibRectangle** pRetVal);
    [id(20006)] HRESULT CreateMatrix([out, retval] IRayLibMatrix** pRetVal);
    [id(20007)] HRESULT CreateCamera2D([out, retval] IRayLibCamera2D** pRetVal);
    [id(20008)] HRESULT CreateCamera3D([out, retval] IRayLibCamera3D** pRetVal);
    [id(20009)] HRESULT CreateTexture([out, retval] IRayLibTexture** pRetVal);
    [id(20010)] HRESULT CreateRenderTexture([out, retval] IRayLibRenderTexture** pRetVal);
}

