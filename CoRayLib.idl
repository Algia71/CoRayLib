    [id(1020)] HRESULT DrawCircle([in] long centerX, [in] long centerY, [in] float radius, [in] IRayLibColor* color);
    [id(1021)] HRESULT DrawCircleV([in] IRayLibVector2* center, [in] float radius, [in] IRayLibColor* color);
