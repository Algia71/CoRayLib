    [id(1043)] HRESULT DrawEllipseLinesV([in] IRayLibVector2* center, [in] float radiusH, [in] float radiusV, [in] IRayLibColor* color);
    [id(1044)] HRESULT DrawRing([in] IRayLibVector2* center, [in] float innerRadius, [in] float outerRadius, [in] float startAngle, [in] float endAngle, [in] long segments, [in] IRayLibColor* color);
    [id(1045)] HRESULT DrawRingLines([in] IRayLibVector2* center, [in] float innerRadius, [in] float outerRadius, [in] float startAngle, [in] float endAngle, [in] long segments, [in] IRayLibColor* color);

    [id(1050)] HRESULT DrawRectangle([in] long posX, [in] long posY, [in] long width, [in] long height, [in] IRayLibColor* color);
    [id(1051)] HRESULT DrawRectangleV([in] IRayLibVector2* position, [in] IRayLibVector2* size, [in] IRayLibColor* color);
    [id(1052)] HRESULT DrawRectangleRec([in] IRayLibRectangle* rec, [in] IRayLibColor* color);
    [id(1053)] HRESULT DrawRectanglePro([in] IRayLibRectangle* rec, [in] IRayLibVector2* origin, [in] float rotation, [in] IRayLibColor* color);
    [id(1054)] HRESULT DrawRectangleGradientV([in] long posX, [in] long posY, [in] long width, [in] long height, [in] IRayLibColor* top, [in] IRayLibColor* bottom);
    [id(1055)] HRESULT DrawRectangleGradientH([in] long posX, [in] long posY, [in] long width, [in] long height, [in] IRayLibColor* left, [in] IRayLibColor* right);
    [id(1056)] HRESULT DrawRectangleGradientEx([in] IRayLibRectangle* rec, [in] IRayLibColor* topLeft, [in] IRayLibColor* bottomLeft, [in] IRayLibColor* bottomRight, [in] IRayLibColor* topRight);
    [id(1057)] HRESULT DrawRectangleLines([in] long posX, [in] long posY, [in] long width, [in] long height, [in] IRayLibColor* color);
    [id(1058)] HRESULT DrawRectangleLinesEx([in] IRayLibRectangle* rec, [in] float lineThick, [in] IRayLibColor* color);
