[
    object,
    dual,
    uuid(BA8623BB-26BE-4D50-94BE-067C1B6785AC),
    pointer_default(unique)
]
interface IRayLib : IDispatch
{
    //////////////////////////////////////////////
    // Module: RCORE

    // Window-related functions
    [id(1)] HRESULT InitWindow([in] long width, [in] long height, [in] BSTR title);
    [id(2)] HRESULT CloseWindow(void);
    [id(3)] HRESULT WindowShouldClose([out, retval] VARIANT_BOOL* pRetVal);
    [id(4)] HRESULT IsWindowReady([out, retval] VARIANT_BOOL* pRetVal);
    [id(5)] HRESULT IsWindowFullscreen([out, retval] VARIANT_BOOL* pRetVal);
    [id(6)] HRESULT IsWindowHidden([out, retval] VARIANT_BOOL* pRetVal);
    [id(7)] HRESULT IsWindowMinimized([out, retval] VARIANT_BOOL* pRetVal);
    [id(8)] HRESULT IsWindowMaximized([out, retval] VARIANT_BOOL* pRetVal);
    [id(9)] HRESULT IsWindowFocused([out, retval] VARIANT_BOOL* pRetVal);
    [id(10)] HRESULT IsWindowResized([out, retval] VARIANT_BOOL* pRetVal);
    [id(11)] HRESULT IsWindowState([in] long flag, [out, retval] VARIANT_BOOL* pRetVal);
    [id(12)] HRESULT SetWindowState([in] long flags);
    [id(13)] HRESULT ClearWindowState([in] long flags);
    [id(14)] HRESULT ToggleFullscreen(void);
    [id(15)] HRESULT ToggleBorderlessWindowed(void);
    [id(16)] HRESULT MaximizeWindow(void);
    [id(17)] HRESULT MinimizeWindow(void);
    [id(18)] HRESULT RestoreWindow(void);
//	[id(19)] HRESULT SetWindowIcon(Image image);
//	[id(20)] HRESULT SetWindowIcons(Image* images, int count);
    [id(21)] HRESULT SetWindowTitle([in] BSTR title);
    [id(22)] HRESULT SetWindowPosition([in] long x, [in] long y);
    [id(23)] HRESULT SetWindowMonitor([in] long monitor);
    [id(24)] HRESULT SetWindowMinSize([in] long width, [in] long height);
    [id(25)] HRESULT SetWindowMaxSize([in] long width, [in] long height);
    [id(26)] HRESULT SetWindowSize([in] long width, [in] long height);
    [id(27)] HRESULT SetWindowOpacity([in] float opacity);
    [id(28)] HRESULT SetWindowFocused(void);
//  [id(29)] HRESULT GetWindowHandle([out, retval] * pRetVal);
    [id(30)] HRESULT GetScreenWidth([out, retval] long* pReVal);
    [id(31)] HRESULT GetScreenHeight([out, retval] long* pReVal);
    [id(32)] HRESULT GetRenderWidth([out, retval] long* pReVal);
    [id(33)] HRESULT GetRenderHeight([out, retval] long* pReVal);
    [id(34)] HRESULT GetMonitorCount([out, retval] long* pReVal);
    [id(35)] HRESULT GetCurrentMonitor([out, retval] long* pReVal);
    [id(36)] HRESULT GetMonitorPosition([in] long monitor, [out, retval] IRayLibVector2** pRetVal);
    [id(37)] HRESULT GetMonitorWidth([in] long monitor, [out, retval] long* pRetVal);
    [id(38)] HRESULT GetMonitorHeight([in] long monitor, [out, retval] long* pRetVal);
    [id(39)] HRESULT GetMonitorPhysicalWidth([in] long monitor, [out, retval] long* pRetVal);
    [id(40)] HRESULT GetMonitorPhysicalHeight([in] long monitor, [out, retval] long* pRetVal);
    [id(41)] HRESULT GetMonitorRefreshRate([in] long monitor, [out, retval] long* pRetVal);
    [id(42)] HRESULT GetWindowPosition([out, retval] IRayLibVector2** pRetVal);
    [id(43)] HRESULT GetWindowScaleDPI([out, retval] IRayLibVector2** pRetVal);
    [id(44)] HRESULT GetMonitorName([in] long monitor, [out, retval] BSTR* pRetVal);
    [id(45)] HRESULT SetClipboardText([in] BSTR text);
    [id(46)] HRESULT GetClipboardText([out, retval] BSTR* pRetVal);
 //	[id(47)] HRESULT Image GetClipboardImage(void);
    [id(48)] HRESULT EnableEventWaiting(void);
    [id(49)] HRESULT DisableEventWaiting(void);

    // Cursor-related functions
    [id(50)] HRESULT ShowCursor(void);
    [id(51)] HRESULT HideCursor(void);
    [id(52)] HRESULT IsCursorHidden([out, retval] VARIANT_BOOL* pRetVal);
    [id(53)] HRESULT EnableCursor(void);
    [id(54)] HRESULT DisableCursor(void);
    [id(55)] HRESULT IsCursorOnScreen([out, retval] VARIANT_BOOL* pRetVal);

    // Drawing-related functions
    [id(70)] HRESULT ClearBackground([in] IRayLibColor* color);
    [id(71)] HRESULT BeginDrawing(void);
    [id(72)] HRESULT EndDrawing(void);
    [id(73)] HRESULT BeginMode2D([in] IRayLibCamera2D* camera);
    [id(74)] HRESULT EndMode2D(void);
    [id(75)] HRESULT BeginMode3D([in] IRayLibCamera3D* camera);
    [id(76)] HRESULT EndMode3D(void);

    [id(81)] HRESULT BeginBlendMode([in] long mode);
    [id(82)] HRESULT EndBlendMode(void);
    [id(83)] HRESULT BeginScissorMode([in] long x, [in] long y, [in] long width, [in] long height);
    [id(84)] HRESULT EndScissorMode(void);

    // VR stereo config functions for VR simulator

    // Shader management functions

    // Screen-space-related functions
    [id(130)] HRESULT GetScreenToWorldRay([in] IRayLibVector2* position, [in] IRayLibCamera3D* camera, [out, retval] IRayLibRay** pRetVal);
    [id(131)] HRESULT GetScreenToWorldRayEx([in] IRayLibVector2* position, [in] IRayLibCamera3D* camera, [in] long width, [in] long height, [out, retval] IRayLibRay** pRetVal);
    [id(132)] HRESULT GetWorldToScreen([in] IRayLibVector3* position, [in] IRayLibCamera3D* camera, [out, retval] IRayLibVector2** pRetVal);
    [id(133)] HRESULT GetWorldToScreenEx([in] IRayLibVector3* position, [in] IRayLibCamera3D* camera, [in] long width, [in] long height, [out, retval] IRayLibVector2** pRetVal);
    [id(134)] HRESULT GetWorldToScreen2D([in] IRayLibVector2* position, [in] IRayLibCamera2D* camera, [out, retval] IRayLibVector2** pRetVal);
    [id(135)] HRESULT GetScreenToWorld2D([in] IRayLibVector2* position, [in] IRayLibCamera2D* camera, [out, retval] IRayLibVector2** pRetVal);
    [id(136)] HRESULT GetCameraMatrix([in] IRayLibCamera3D* camera, [out, retval] IRayLibMatrix** pRetVal);
    [id(137)] HRESULT GetCameraMatrix2D([in] IRayLibCamera2D* camera, [out, retval] IRayLibMatrix** pRetVal);

    // Timing-related functions
    [id(140)] HRESULT SetTargetFPS([in] long fps);
    [id(141)] HRESULT GetFrameTime([out, retval] float* pRetVal);
    [id(142)] HRESULT GetTime([out, retval] double* pRetVal);
    [id(143)] HRESULT GetFPS([out, retval] long* pRetVal);

    // Custom frame control functions
    [id(150)] HRESULT SwapScreenBuffer(void);
    [id(151)] HRESULT PollInputEvents(void);
    [id(152)] HRESULT WaitTime([in] double seconds);

    // Random values generation functions
    [id(160)] HRESULT SetRandomSeed([in] long seed);
    [id(161)] HRESULT GetRandomValue([in] long min, [in] long max, [out, retval] long* pRetVal);

    // Misc. functions
    [id(170)] HRESULT TakeScreenshot([in] BSTR fileName);
    [id(171)] HRESULT SetConfigFlags([in] long flags);
    [id(172)] HRESULT OpenURL([in] BSTR url);

    // Logging system
    [id(173)] HRESULT SetTraceLogLevel([in] long logLevel);

    // Memory management, using internal allocators

    // File system management functions

    // File access custom callbacks

    // Compression/Encoding functionality

    // Automation events functionality

    // Input-related functions: keyboard
    [id(330)] HRESULT IsKeyPressed([in] long key, [out, retval] VARIANT_BOOL* pRetVal);
    [id(331)] HRESULT IsKeyPressedRepeat([in] long key, [out, retval] VARIANT_BOOL* pRetVal);
    [id(332)] HRESULT IsKeyDown([in] long key, [out, retval] VARIANT_BOOL* pRetVal);
    [id(333)] HRESULT IsKeyReleased([in] long key, [out, retval] VARIANT_BOOL* pRetVal);
    [id(334)] HRESULT IsKeyUp([in] long key, [out, retval] VARIANT_BOOL* pRetVal);
    [id(335)] HRESULT GetKeyPressed([out, retval] long* pRetVal);
    [id(336)] HRESULT GetCharPressed([out, retval] long* pRetVal);
    [id(337)] HRESULT SetExitKey([in] long key);

    // Input-related functions: gamepads
    [id(338)] HRESULT IsGamepadAvailable([in] long gamepad, [out, retval] VARIANT_BOOL* pRetVal);
    [id(339)] HRESULT GetGamepadName([in] long gamepad, [out, retval] BSTR* pRetVal);
    [id(340)] HRESULT IsGamepadButtonPressed([in] long gamepad, [in] long button, [out, retval] VARIANT_BOOL* pRetVal);
    [id(341)] HRESULT IsGamepadButtonDown([in] long gamepad, [in] long button, [out, retval] VARIANT_BOOL* pRetVal);
    [id(342)] HRESULT IsGamepadButtonReleased([in] long gamepad, [in] long button, [out, retval] VARIANT_BOOL* pRetVal);
    [id(343)] HRESULT IsGamepadButtonUp([in] long gamepad, [in] long button, [out, retval] VARIANT_BOOL* pRetVal);
    [id(344)] HRESULT GetGamepadButtonPressed([out, retval] long* pRetVal);
    [id(345)] HRESULT GetGamepadAxisCount([in] long gamepad, [out, retval] long* pRetVal);
    [id(346)] HRESULT GetGamepadAxisMovement([in] long gamepad, [in] long axis, [out, retval] float* pRetVal);
    [id(347)] HRESULT SetGamepadMappings([in] BSTR mappings, [out, retval] long* pRetVal);
    [id(348)] HRESULT SetGamepadVibration([in] long gamepad, [in] float leftMotor, [in] float rightMotor, [in] float duration);

    // Input-related functions: mouse
    [id(360)] HRESULT IsMouseButtonPressed([in] long button, [out, retval] VARIANT_BOOL* pRetVal);
    [id(361)] HRESULT IsMouseButtonDown([in] long button, [out, retval] VARIANT_BOOL* pRetVal);
    [id(362)] HRESULT IsMouseButtonReleased([in] long button, [out, retval] VARIANT_BOOL* pRetVal);
    [id(363)] HRESULT IsMouseButtonUp([in] long button, [out, retval] VARIANT_BOOL* pRetVal);
    [id(364)] HRESULT GetMouseX([out, retval] long* pRetVal);
    [id(365)] HRESULT GetMouseY([out, retval] long* pRetVal);
    [id(366)] HRESULT GetMousePosition([out, retval] IRayLibVector2** pRetVal);
    [id(367)] HRESULT GetMouseDelta([out, retval] IRayLibVector2** pRetVal);
    [id(368)] HRESULT SetMousePosition([in] long x, [in] long y);
    [id(369)] HRESULT SetMouseOffset([in] long offsetX, [in] long offsetY);
    [id(370)] HRESULT SetMouseScale(float scaleX, float scaleY);
    [id(371)] HRESULT GetMouseWheelMove([out, retval] float* pRetVal);
    [id(372)] HRESULT GetMouseWheelMoveV([out, retval] IRayLibVector2** pRetVal);
    [id(373)] HRESULT SetMouseCursor([in] long cursor);

    // Input-related functions: touch
    [id(374)] HRESULT GetTouchX([out, retval] long* pRetVal);
    [id(375)] HRESULT GetTouchY([out, retval] long* pRetVal);
    [id(376)] HRESULT GetTouchPosition([in] long index, [out, retval] IRayLibVector2** pRetVal);
    [id(377)] HRESULT GetTouchPointId([in] long index, [out, retval] long* pRetVal);
    [id(378)] HRESULT GetTouchPointCount([out, retval] long* pRetVal);

    // Gestures and Touch Handling Functions (Module: rgestures)
    [id(379)] HRESULT SetGesturesEnabled([in] long flags);
    [id(380)] HRESULT IsGestureDetected([in] long gesture, [out, retval] VARIANT_BOOL* pRetVal);
    [id(381)] HRESULT GetGestureDetected([out, retval] long* pRetVal);
    [id(382)] HRESULT GetGestureHoldDuration([out, retval] float* pRetVal);
    [id(383)] HRESULT GetGestureDragVector([out, retval] IRayLibVector2** pRetVal);
    [id(384)] HRESULT GetGestureDragAngle([out, retval] float* pRetVal);
    [id(385)] HRESULT GetGesturePinchVector([out, retval] IRayLibVector2** pRetVal);
    [id(386)] HRESULT GetGesturePinchAngle([out, retval] float* pRetVal);

    // Camera System Functions (Module: rcamera)
    [id(400)] HRESULT UpdateCamera([in] IRayLibCamera3D* camera, [in] long mode);
    [id(401)] HRESULT UpdateCameraPro([in] IRayLibCamera3D* camera, [in] IRayLibVector3* movement, [in] IRayLibVector3* rotation, [in] float zoom);

    //////////////////////////////////////////////
    // Module: RSHAPES

    [id(1002)] HRESULT GetShapesTextureRectangle([out, retval] IRayLibRectangle** pRetVal);

    // Basic shapes drawing functions
    [id(1010)] HRESULT DrawPixel([in] long posX, [in] long posY, [in] IRayLibColor* color);
    [id(1011)] HRESULT DrawPixelV([in] IRayLibVector2* position, [in] IRayLibColor* color);
    [id(1012)] HRESULT DrawLine([in] long startPosX, [in] long startPosY, [in] long endPosX, [in] long endPosY, [in] IRayLibColor* color);
    [id(1013)] HRESULT DrawLineV([in] IRayLibVector2* startPos, [in] IRayLibVector2* endPos, [in] IRayLibColor* color);
